# Directus instance this club site's collections live on. The instance is
# shared with other projects (BucketBoard, PinGather, LocalRater, the health
# network) — every collection this tooling creates is prefixed `hrc_` and
# grouped under the `hrc_club` folder so nothing here can collide with, or
# reach into, another project's schema.
DIRECTUS_URL=https://your-directus-instance.example.com

# Admin login used ONLY by the bootstrap scripts in this package
# (schema:apply, permissions:apply). Never used at runtime by the web app —
# that authenticates with the narrowly-scoped service token below.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Drives the "<APP_NAME> Service" policy/role name and the folder note.
APP_NAME=HRC Club

# Public origin the site is served from — used for links in flow-sent email
# and for the on-demand revalidation webhook target.
APP_BASE_URL=https://hrc-club.vercel.app

# Email for the dedicated, non-human directus_users row that carries the
# Express server's static token. Created by `npm run permissions:apply`,
# which prints the token once — paste it into the app's root .env as
# DIRECTUS_SERVICE_TOKEN.
SERVICE_ACCOUNT_EMAIL=service@hrc-club.dev
