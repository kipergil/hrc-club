# --- Directus (the site's data) ---
# The instance the hrc_* collections live on. Shared with other projects;
# this app can only see its own, because of how the service token is scoped.
DIRECTUS_URL=https://your-directus-instance.example.com

# Static token for the narrowly-scoped "HRC Club Service" role. Generated by
# `npm run directus:permissions:apply` and printed once — paste it here.
DIRECTUS_SERVICE_TOKEN=

# Development-only fallback, used when DIRECTUS_SERVICE_TOKEN is empty so the
# site can be run before the service token exists. Refused outright when
# NODE_ENV=production — a public site must never authenticate as an admin.
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# --- Rebuild webhook ---
# Shared secret required by POST /api/revalidate and POST /api/sync/league.
# Set the same value on the Directus Flow that calls them.
WEBHOOK_SECRET=
# Vercel Deploy Hook. When content changes in Directus, a Flow calls
# /api/revalidate, which calls this — so the prerendered pages catch up with
# the API within a minute or two.
VERCEL_DEPLOY_HOOK_URL=

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Entering match results -------------------------------------------------

# The shared password for /admin/scorecards. Unset means result entry is off
# and every scorecard endpoint returns 503, which is the right default for a
# deployment nobody has configured. This is a shared secret, not accounts: it
# proves the caller knows the password and cannot tell you who entered a card.
ADMIN_TOKEN=

# Reads photographed match cards. Unset is a supported state — the upload
# screen says so plainly and typing a card in works exactly the same way.
ANTHROPIC_API_KEY=

# Required only if the key above is identity-linked — a key tied to a person
# rather than to a single workspace. Such a key does not say which workspace
# a request belongs to, and the API refuses it with:
#
#   anthropic-workspace-id is required when authenticating with an
#   identity-linked API key
#
# The id is on the workspace's page in the Anthropic Console and looks like
# wrkspc_01… . A workspace-scoped key carries its own workspace and needs
# nothing here, so leave this empty unless you see that error.
ANTHROPIC_WORKSPACE_ID=

# Overridable so a cheaper model can be tried against real cards without a
# deploy. Defaults to claude-opus-5.
SCORECARD_MODEL=
