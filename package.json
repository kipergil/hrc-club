{
  "name": "hrc-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && npm run prerender && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:vercel": "vite build && npm run prerender",
    "prerender": "tsx scripts/prerender.tsx",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run check && npm run test && npm run build",
    "directus:schema:apply": "npm --prefix directus run schema:apply",
    "directus:permissions:apply": "npm --prefix directus run permissions:apply",
    "directus:seed": "npm --prefix directus run seed",
    "directus:import:league": "npm --prefix directus run import:league",
    "directus:import:content": "npm --prefix directus run import:content",
    "directus:import:archive": "npm --prefix directus run import:archive",
    "directus:geocode:venues": "npm --prefix directus run geocode:venues",
    "directus:sample:results": "npm --prefix directus run sample:results",
    "directus:write:features": "npm --prefix directus run write:features",
    "directus:import:club-notes": "npm --prefix directus run import:club-notes"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@directus/sdk": "^18.0.3",
    "@radix-ui/react-accordion": "^1.2.4",
    "@tanstack/react-query": "^5.60.5",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.3.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
